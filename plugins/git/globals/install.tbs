import stdlib;
import tebas;
import tebasplugin;
import "utils.gitignore";

genericExecutable("Git", "git", "gitPath", "git", "git");
gitignoreFile();

function gitignoreFile(){
	ensureDefaultGitignoreExists();
}

function genericExecutable(capitalizedName, name, resourceName, sharedName, testFirst){
	//Previous template resources
	tab pr = tebasplugin::getResource(resourceName);
	if pr > 0{
		print(capitalizedName + " executable path gotten from previous plugin resources: '" + pr + "'");
		testProcess(pr);
		return;
	}
	
	//Test before other things
	if testFirst^ != "" & testProcess(testFirst){
		tebasplugin::setResource(resourceName, testFirst);
		tebas::setShared("paths." + sharedName, testFirst);
		print(capitalizedName + " executable path gotten from the default: '" + testFirst + "'");
		return;
	}
	
	//Shared resources
	tab sr = tebas::getShared("paths." + sharedName);
	if sr > 0{
		tebasplugin::setResource(resourceName, sr);
		print(capitalizedName + " executable path gotten from shared resources: '" + sr + "'");
		testProcess(sr);
		return;
	}
	
	//User input
	tab m = input("Enter " + name + " executable path: ").removeQuotes();
	tebasplugin::setResource(resourceName, m);
	if testProcess(m){
		tebas::setShared("paths." + sharedName, m); //Only save if it was succesfully tested
	}
}

function testProcess(path){
	tab num = tebasplugin::runProcessSilent(path, "", ["-h"]);
	
	if num.length == 0{
		error("'" + path + "' does not seem to be a runnable process");
		return 0;
	}
	
	return 1;
}
