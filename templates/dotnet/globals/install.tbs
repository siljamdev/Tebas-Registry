import stdlib;
import tebas;
import tebastemplate;
import "utils.csproj";

genericExecutable("Dotnet", "dotnet", "dotnetPath", "dotnet", "dotnet");
author();
company();
csprojFile();

function genericExecutable(capitalizedName, name, resourceName, sharedName, testFirst){
	//Previous template resources
	tab pr = tebastemplate::getResource(resourceName);
	if pr > 0{
		print(capitalizedName + " executable path gotten from previous template resources: '" + pr + "'");
		testProcess(pr);
		return;
	}
	
	//Test before other things
	if testFirst^ != "" & testProcess(testFirst){
		tebastemplate::setResource(resourceName, testFirst);
		tebas::setShared("paths." + sharedName, testFirst);
		print(capitalizedName + " executable path gotten from the default: '" + testFirst + "'");
		return;
	}
	
	//Shared resources
	tab sr = tebas::getShared("paths." + sharedName);
	if sr > 0{
		tebastemplate::setResource(resourceName, sr);
		print(capitalizedName + " executable path gotten from shared resources: '" + sr + "'");
		testProcess(sr);
		return;
	}
	
	//User input
	tab m = input("Enter " + name + " executable path: ").removeQuotes();
	tebastemplate::setResource(resourceName, m);
	if testProcess(m){
		tebas::setShared("paths." + sharedName, m); //Only save if it was succesfully tested
	}
}

function author(){
	tab pr = tebastemplate::getResource("author");
	if pr.trim()% > 0{
		print("Author name gotten from previous template resources");
		return;
	}
	
	tab sr = getShared("author");
	if sr.trim()% > 0{
		tebastemplate::setResource("author", sr);
		print("Author name gotten from shared resources");
		return;
	}
	
	tab m = input("Enter your author name: ").trim();
	tebastemplate::setResource("author", m);
	setShared("author", m);
}

function company(){
	tab pr = tebastemplate::getResource("company");
	if pr.trim()% > 0{
		print("Company name gotten from previous template resources");
		return;
	}
	
	tab sr = getShared("company");
	if sr.trim()% > 0{
		tebastemplate::setResource("company", sr);
		print("Company name gotten from shared resources");
		return;
	}
	
	tab m = input("Enter your company name: ").trim();
	tebastemplate::setResource("company", m);
	setShared("company", m);
}

function csprojFile(){
	ensureDefaultCsprojExists();
}

function testProcess(path){
	tab num = tebastemplate::runProcessSilent(path, "", ["-h"]);
	
	if num.length == 0{
		error("'" + path + "' does not seem to be a runnable process");
		return 0;
	}
	
	return 1;
}
