import stdlib;
import tebas;
import tebastemplate;

if args.length != 0{
	error("Expected 0 arguments");
	exit;
}

print(getName() + " template help");
print("");
print("Scripts:");
print("  run [ip]             Runs the project in the 3DS with 3dslink if build succeeds");
print("  debug                Builds and debugs the project with gdb");
print("  build                Builds the project");
print("  link [ip]            Runs the project in the 3DS with 3dslink. The ip will be cached in a file called .ip");
print("  publish <version>    Builds a .cia file into the releases folder");
print("Globals:");
print("  edit-makefile            Edit the default Makefile file");
print("  tconfig <key> <value>    Change the config. Use 'list' as key to get all valid keys, and 'see' to see the current config");
print("  help                     This help menu");
print("");
print("This template is used with devkitPro for creating 3DS games (.3dsx files)");
print("");
print("The default Makefile generated by the template is enough for most simple projects");
print("The source code .c, .cpp or .s files are expected to go in source/ and the header .h files are expected to go in include/");
print("The source code for PICA200 shaders .v.pica, .g.pica or .shlist files are expected to go in shaders/");
print("All intermediate build files will go in build/");
print("The generated .3dsx files will be in build/ as well");
print("");
print("HOME menu banners are generated using bannertool. ");
print("  Banner files are expected to go in banner/");
print("  These are: banner.png (must be 256x128) and sound.wav/soung.ogg");
print("");
print("Makerom is used to generate installable .cia files");
print("  releases/app.rsf is the Rom Specification File used with makerom");
print("  Publishing will generate a .cia file inside releases");
print("");
print("This is a good tutorial to follow (although its in french): https://www.gekkode.com/developpement/comment-developper-un-jeu-homebrew-pour-nintendo-3ds");