import stdlib;
import tebas;
import tebastemplate;
import tebasproject;

//ONLY ADD TO SCRIPTS!!!!

export function createBanner(){
	if !tebasproject::folderExists("banner"){
		return 0;
	}
	
	tab im = getImageOption();
	tab au = getAudioOption();
	
	if(!im & !au){
		return 0;
	}
	
	tab exitCode = tebasproject::runProcess(tebastemplate::getResource("bannertoolPath"), "banner", ["makebanner", im, au, "-o", "banner.bnr"]);
	
	return exitCode == "0";
}

function getImageOption(){
	if tebasproject::fileExists("banner/banner.cgfx"){
		return ["-ci", "banner.cgfx"];
	}else if tebasproject::fileExists("banner/banner.png"){
		return ["-i", "banner.png"];
	}else{
		return [];
	}
}

function getAudioOption(){
	if tebasproject::fileExists("banner/sound.cwav"){
		return ["-ca", "sound.cwav"];
	}else if tebasproject::fileExists("banner/sound.wav"){
		return ["-a", "sound.wav"];
	}else if tebasproject::fileExists("banner/sound.ogg"){
		return ["-a", "sound.ogg"];
	}else{
		return [];
	}
}
