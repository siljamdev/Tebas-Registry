import stdlib;
import stdnum;
import tebas;
import tebasproject;
import tebastemplate;

if args.length != 0{
	error("Expected 0 arguments");
	exit;
}

build();

export function build(){
	tab exitCode = tebasproject::runProcess(tebastemplate::getResource("bashPath"), "", ["-lc", $"cd {tebasproject::getPath().replace("\\", "/")} && make"]);
	
	if exitCode == "0"{
		tebasproject::setResource("timesBuilt", stdnum::sum(tebasproject::getResource("timesBuilt"), "1"));
	}
	
	return exitCode == "0";
}
