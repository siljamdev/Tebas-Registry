import stdlib;
import tebas;
import tebasproject;
import tebastemplate;

tab ip = [];

if args.length != 1{
	error("Expected 1 argument: 'enabled'");
	exit;
}

if args.0.lower() == "t" | args.0.lower() == "true"{
	tebasproject::setResource("server", "true");
}else{
	tebasproject::setResource("server", "false");
}
