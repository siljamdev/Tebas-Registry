import stdlib;
import tebas;
import tebasproject;
import tebastemplate;

tab ip = [];

if args.length != 1{
	error("Expected 1 argument: 'enabled'");
	exit;
}

if args.0.lower() == "t" | args.0.lower() == "true"{
	args.0 = "true";
}else if args.0.lower() == "f" | args.0.lower() == "false"{
	args.0 = "false";
}else{
	error("Argument must be either 'true' or 'false'");
	exit;
}

tebasproject::setResource("server", args.0);
