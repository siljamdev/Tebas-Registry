import stdlib;
import tebas;
import tebasproject;
import tebastemplate;
import stdnum;
import "utils.ip";

tab ip = [];

if args < 0 | args > 1{
	error("Expected 0 or 1 arguments: 'ip'");
	exit;
}

tab saved = tebasproject::getResource("ip");

if args.length == 1 & isIp(args.0){
	ip = args.0;
	tebasproject::setResource("ip", ip);
}else if saved{
	ip = saved;
	print("Using saved ip: " + ip);
}else{
	print("ip needed: in your 3ds, open the homebrew launcher and press Y to find the ip");
	exit;
}

tab path = "build/" + tebasproject::getName() + ".3dsx";
if !tebasproject::fileExists(path){
	error("Missing .3dsx file, build first");
	exit;
}

tab arg = ["-a", ip];
if tebasproject::getResource("server") == "true"{
	arg += "-s";
}
arg += path^;

print("In your console, open the homebrew launcher and press Y. Make sure your device and your 3ds are on the same network!");

tebasproject::runProcess(tebastemplate::getResource("3dslinkPath"), "", arg);
