import stdlib;
import tebas;
import tebasproject;
import tebastemplate;
import "scripts.build";

if build(){
	runAndWait();
}

function runAndWait(){
	tab path = "./" + tebasproject::getName() + ".elf";
	if tebastemplate::getResource("runDetached") == "true"{
		tebasproject::runProcessDetached(tebastemplate::getResource("gdbPath"), "build/", path^);
	}else{
		tebasproject::runProcess(tebastemplate::getResource("gdbPath"), "build/", path^);
	}
}
